{
  "name": "ai-debate-room",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "preprod": "npm run build",
    "prod": "cd dist && node index.js",
    "server": "cd dist && node index.js",
    "start:prod": "cd dist && node --env-file ../.env index.js",
    "start": "tsx --env-file .env index.ts",
    "dev": "tsx watch --env-file .env index.ts",
    "reset": "npm install && npm update && npm run build",
    "upgrade-deps": "npx npm-check-updates -u",
    "test": "mocha --node-option import=tsx 'test/**/*.spec.ts' -t 20000",
    "render": "tsx src/cli/render.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "check-all": "npm run lint && npm run type-check",
    "combine": "node combine.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/mistral": "4.0.66",
    "@ai-sdk/openai": "4.0.96",
    "@mastra/core": "^1.80.0",
    "@volcanicminds/backend": "^2.3.2",
    "@volcanicminds/tools": "^0.1.2",
    "dotenv": "^18.0.9",
    "mastra": "^1.36.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "telegraf": "^4.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
